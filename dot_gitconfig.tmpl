# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = {{ .git.name }}
	email = {{ .git.email }}
[core]
	# editor = code --wait
	editor = nvim
	pager = delta
[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or `light = true`, or omit for auto-detection
	map-styles = bold purple => syntax "#3f2d56", bold cyan => syntax "#1e3a5f"
[merge]
	conflictStyle = zdiff3
[alias]
	diff-origin = !git fetch origin && git diff \"origin/$(git branch --show-current)\"
	reset-origin = !git fetch origin && git reset --hard \"origin/$(git branch --show-current)\"

	log-today = "!git log --all --no-merges --author=\"$(git config user.email)\" --since=midnight --date=format:'%I:%M %p' --format='%C(auto)%h %C(dim)%ad%C(reset)%C(auto)%d%C(reset) %s'"

	gone = "!git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\"{print $1}'"
	prune-gone = "!git gone | xargs -r git branch -d"
	prune-gone-force = "!git gone | xargs -r git branch -D"
	
	# replay my own commits onto <ref> (default @{upstream}), dropping any commit below them that <ref> has abandoned
	restack = "!f() { u=$1; [ -z \"$u\" ] && u=@{upstream}; me=$(git config user.email); tip=$(git log -1 --format=%ae \"$u..HEAD\"); [ -n \"$tip\" ] && [ \"$tip\" != \"$me\" ] && { echo \"restack: top of $u..HEAD is not authored by $me\" >&2; return 1; }; base=$(git log --format='%H %ae' \"$u..HEAD\" | awk -v me=\"$me\" '$2 != me { print $1; exit }'); git rebase --onto \"$u\" \"${base:-$(git merge-base \"$u\" HEAD)}\"; }; f"
	restack-origin = !git fetch origin && git restack \"origin/$(git branch --show-current)\"
