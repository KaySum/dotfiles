# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = {{ .git.name }}
	email = {{ .git.email }}
[core]
	# editor = code --wait
	editor = nvim
	pager = delta
[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or `light = true`, or omit for auto-detection
	map-styles = bold purple => syntax "#3f2d56", bold cyan => syntax "#1e3a5f"
[merge]
	conflictStyle = zdiff3
[alias]
	diff-origin = !git fetch origin && git diff \"origin/$(git branch --show-current)\"
	reset-origin = !git fetch origin && git reset --hard \"origin/$(git branch --show-current)\"

	log-today = "!git log --all --no-merges --author=\"$(git config user.email)\" --since=midnight --date=format:'%I:%M %p' --format='%C(auto)%h %C(dim)%ad%C(reset)%C(auto)%d%C(reset) %s'"

	gone = "!git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\"{print $1}'"
	prune-gone = "!git gone | xargs -r git branch -d"
	prune-gone-force = "!git gone | xargs -r git branch -D"
	
	# replay my own commits onto <ref> (default @{upstream}), dropping any commit below them that <ref> has abandoned
	restack = "!f() { u=$1; [ -z \"$u\" ] && u=@{upstream}; me=$(git config user.email); tip=$(git log -1 --format=%ae \"$u..HEAD\"); [ -n \"$tip\" ] && [ \"$tip\" != \"$me\" ] && { echo \"restack: top of $u..HEAD is not authored by $me\" >&2; return 1; }; base=$(git log --format='%H %ae' \"$u..HEAD\" | awk -v me=\"$me\" '$2 != me { print $1; exit }'); git rebase --onto \"$u\" \"${base:-$(git merge-base \"$u\" HEAD)}\"; }; f"
	restack-origin = !git fetch origin && git restack \"origin/$(git branch --show-current)\"
	
	# log commits authored or co-authored by <pattern> (case-insensitive substring of "Name <email>")
	log-by-author = "!f() { [ $# -ge 1 ] || { echo 'usage: git log-by-author <pattern> [<revision-range>]' >&2; return 1; }; p=$1; shift; m=$(git log --format='%H%x09%an <%ae>%x09%(trailers:key=Co-authored-by,valueonly,separator=%x09)' \"$@\" | awk -F'\\t' -v p=\"$p\" 'BEGIN { p = tolower(p) } { for (i = 2; i <= NF; i++) if (index(tolower($i), p)) { print $1; next } }'); [ -n \"$m\" ] || return 0; git log --no-walk=unsorted --date=short --format='%C(auto)%h %C(dim)%ad %an%C(reset)%C(auto)%d%C(reset) %s' $m; }; f"
	# rewrite <commit>... on the current branch to a single author/committer, dropping any co-author trailers
	set-author = "!f() { [ $# -ge 3 ] || { echo 'usage: git set-author <commit>... <name> <email>' >&2; return 1; }; i=$(($# - 2)); while [ $i -gt 0 ]; do set -- \"$@\" \"$1\"; shift; i=$((i - 1)); done; n=$1; e=$2; shift 2; t=' '; for c in \"$@\"; do t=\"$t$(git rev-parse --verify \"$c^{commit}\") \" || return 1; done; NEW_NAME=\"$n\" NEW_EMAIL=\"$e\" TARGETS=\"$t\" FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch -f --env-filter 'case \"$TARGETS\" in *\" $GIT_COMMIT \"*) GIT_AUTHOR_NAME=$NEW_NAME; GIT_AUTHOR_EMAIL=$NEW_EMAIL; GIT_COMMITTER_NAME=$NEW_NAME; GIT_COMMITTER_EMAIL=$NEW_EMAIL;; esac' --msg-filter 'case \"$TARGETS\" in *\" $GIT_COMMIT \"*) grep -vi \"^co-authored-by:\" | git stripspace;; *) cat;; esac' --tag-name-filter cat -- HEAD; }; f"
	swap-author = "!f() { [ $# -eq 3 ] || { echo 'usage: git swap-author <pattern> <name> <email>' >&2; return 1; }; l=$(git -c color.ui=false log-by-author \"$1\" | awk '{print $1}') || return 1; [ -n \"$l\" ] || return 0; git set-author $l \"$2\" \"$3\"; }; f"
	claim = "!f() { [ $# -ge 1 ] || { echo 'usage: git claim <commit>...' >&2; return 1; }; git set-author \"$@\" \"$(git config user.name)\" \"$(git config user.email)\"; }; f"
	claim-from = "!f() { [ $# -eq 1 ] || { echo 'usage: git claim-from <commit>' >&2; return 1; }; git merge-base --is-ancestor \"$1\" HEAD || { echo \"claim-from: $1 is not an ancestor of HEAD\" >&2; return 1; }; git claim \"$1\" $(git rev-list \"$1\"..HEAD); }; f"
	claim-by = "!f() { [ $# -eq 1 ] || { echo 'usage: git claim-by <pattern>' >&2; return 1; }; l=$(git -c color.ui=false log-by-author \"$1\" | awk '{print $1}') || return 1; [ -n \"$l\" ] || return 0; git claim $l; }; f"
